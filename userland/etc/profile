export PATH="$HOME/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:."
export TERM='xterm-256color'
export LANG='C.UTF-8'
export LC_CTYPE='C.UTF-8'
export ENV='/etc/shrc'
case $- in
  *i*) if [ -n "${BASH_VERSION-}" ] && [ -r "$HOME/.bashrc" ]; then . "$HOME/.bashrc"; fi ;;
esac
