python = import('python').find_installation('python3')
foreach pkg : packages
  outputs = []
  foreach member : pkg[2]
    outputs += member.split('/')[-1]
  endforeach
  userland_image_targets += custom_target('userland-' + outputs[0],
    output: outputs,
    command: [python, files('unpack.py'), meson.project_source_root() / '.cache/packages',
              pkg[0], pkg[1], meson.current_build_dir(), pkg[2]])
endforeach

sdk_inputs = {
  'apk': [
    alpine + 'mbedtls-dev-3.6.8-r0.apk', '98f83441c265f0956165665b3b0d65a8ed8d78c9803c1a8339dd2843a05e0219',
    alpine + 'mbedtls-static-3.6.8-r0.apk', '3ea13fc9841b1bdfebf6a88259f7bb2ec72416dbcb2b2308d2e9f4fffde97d02',
    alpine + 'zlib-dev-1.4-r0.apk', '0a3a7a4f23f1bc853d8aad7ab892e73b9b81f103fa74b53d427966db729ff399',
    alpine + 'zlib-static-1.4-r0.apk', '88b41ba28000b841781875939cec705cbf3e84e9d60762381b94fc31ea14cab3',
  ],
  'tls': [
    alpine24 + 'mbedtls-dev-4.1.2-r0.apk', '7304399bcc0fad5cb4bf692d3b607d37c342abcbaa06689a96da66c6f4360be6',
    alpine24 + 'mbedtls-static-4.1.2-r0.apk', '6543e830999678f2dc6bb3281eaba945ab49aa28cf85d7f31176a05daca14be7',
  ],
}
sdks = {}
foreach name, archives : sdk_inputs
  sdks += {name: custom_target(name + '-sdk',
    output: name + '-sdk.stamp',
    command: [python, '-B', files('sdk.py'), meson.project_source_root() / '.cache/packages',
              meson.current_build_dir() / (name + '-sdk'), '@OUTPUT@', archives],
    depend_files: files('unpack.py'))}
endforeach
